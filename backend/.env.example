DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/indicator_tracking

# Seguridad por roles.
# En desarrollo puede mantenerse desactivado. En despliegue usar AUTH_ENABLED=true.
AUTH_ENABLED=false
AUTH_SECRET_KEY=change-this-secret-before-production
AUTH_TOKEN_TTL_MINUTES=480
AUTH_USERS_JSON={"clinico":{"password":"rsa2026.","role":"clinical","display_name":"Usuario clinico"},"supervisor":{"password":"rsa2026.","role":"supervisor","display_name":"Usuario supervisor"},"admin":{"password":"adminrsa2026.","role":"admin","display_name":"Administrador"}}

# Respaldo y retencion.
# Si pg_dump no esta en el PATH, configurar la ruta completa.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
BACKUP_RETENTION_DAYS=30
UPLOAD_RETENTION_DAYS=7

# Automatizacion de descarga desde DIRESA Cloud.
DIRESA_CLOUD_BASE_URL=https://cloud.diresaapurimac.gob.pe
DIRESA_CLOUD_USERNAME=
DIRESA_CLOUD_PASSWORD=
DIRESA_CLOUD_VERIFY_TLS=true
AUTOMATION_DOWNLOAD_DIR=backend/automation_downloads
